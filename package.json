{
  "name": "iobroker.lgtv",
  "version": "3.0.1",
  "description": "ioBroker LG WebOS SmartTV Adapter",
  "author": "Sebastian Schultz <mail@sebastian-schultz.de>",
  "contributors": [
    "Hobbyquaker <hq@ccu.io>",
    "iobroker-community-adapters <mcm57@gmx.at>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/iobroker.lgtv",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "lgtv",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iobroker-community-adapters/ioBroker.lgtv.git"
  },
  "engines": {
    "node": ">= 22.19"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "lgtv2": "^2.0.0",
    "wol": "^1.0.7"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^2.0.15",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@types/wol": "^1.0.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "watch": "tsc -p tsconfig.build.json --watch",
    "build-devices": "tsx tasks.ts",
    "devices-0-clean": "tsx tasks.ts --0-clean",
    "devices-1-npm": "tsx tasks.ts --1-npm",
    "devices-2-build": "tsx tasks.ts --2-build",
    "devices-3-copy": "tsx tasks.ts --3-copy",
    "check": "tsc -p tsconfig.json --noEmit",
    "check-devices": "tsc --noEmit -p src-devices/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs",
    "test:js": "npm run build && mocha test/probe --exit",
    "test:package": "mocha test/packageFiles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:js && npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade"
  },
  "bugs": {
    "url": "https://github.com/SebastianSchultz/iobroker.lgtv/issues"
  },
  "readmeFilename": "README.md"
}
